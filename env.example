# Copy to .env.local and fill in the two auth values. Never commit the real file.
#
# Public origin of the app, for example http://localhost:3000
BETTER_AUTH_URL=
#
# Required in production: 32+ random characters.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=
#
# Local SQLite database path.
DATABASE_URL=./data/app.db
# Comma-separated hostnames allowed by the SSRF-safe fetch demo.
SAFE_FETCH_ALLOWLIST=example.com
